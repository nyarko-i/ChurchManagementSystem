generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Church {
  id                   String                @id @default(uuid())
  name                 String
  slug                 String                @unique
  email                String
  phone                String
  address              String?
  subscriptionPlan     SubscriptionPlan      @default(starter)
  subscriptionStatus   SubscriptionStatus    @default(active)
  createdAt            DateTime              @default(now())
  auditLogs            AuditLog[]
  contributions        Contribution[]
  contributionTypes    ContributionType[]
  expenses             Expense[]
  members              Member[]
  offerings            Offering[]
  smsLogs              SmsLog[]
  titheRecords         TitheRecord[]
  users                User[]
  welfareContributions WelfareContribution[]
  welfarePayouts       WelfarePayout[]
  welfareRequests      WelfareRequest[]
  welfareSettings      WelfareSettings?
}

model SuperAdmin {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  lastLoginAt  DateTime?
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  email     String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model User {
  id           String   @id @default(uuid())
  churchId     String
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(secretary)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  church       Church   @relation(fields: [churchId], references: [id])
}

model Member {
  id                   String                @id @default(uuid())
  churchId             String
  memberNumber         String
  firstName            String
  lastName             String
  phone                String?
  email                String?
  gender               Gender?
  dateOfBirth          DateTime?
  address              String?
  occupation           String?
  joinDate             DateTime              @default(now())
  status               MemberStatus          @default(active)
  createdAt            DateTime              @default(now())
  contributions        Contribution[]
  church               Church                @relation(fields: [churchId], references: [id])
  smsLogs              SmsLog[]
  titheRecords         TitheRecord[]
  welfareContributions WelfareContribution[]
  welfareRequests      WelfareRequest[]

  @@unique([churchId, memberNumber])
  @@index([churchId])
  @@index([phone])
}

model TitheRecord {
  id            String        @id @default(uuid())
  churchId      String
  memberId      String
  month         Int
  year          Int
  week1Amount   Float?
  week2Amount   Float?
  week3Amount   Float?
  week4Amount   Float?
  monthlyAmount Float?
  paymentMethod PaymentMethod @default(cash)
  isSigned      Boolean       @default(false)
  signedBy      String?
  signedAt      DateTime?
  recordedBy    String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  church        Church        @relation(fields: [churchId], references: [id])
  member        Member        @relation(fields: [memberId], references: [id])

  @@unique([churchId, memberId, month, year])
  @@index([churchId])
  @@index([memberId])
}

model WelfareSettings {
  id            String   @id @default(uuid())
  churchId      String   @unique
  amount        Float
  effectiveYear Int
  updatedBy     String
  updatedAt     DateTime @updatedAt
  church        Church   @relation(fields: [churchId], references: [id])
}

model WelfareContribution {
  id             String        @id @default(uuid())
  churchId       String
  memberId       String
  month          Int
  year           Int
  paymentMethod  PaymentMethod @default(cash)
  recordedBy     String?
  createdAt      DateTime      @default(now())
  isSigned       Boolean       @default(false)
  monthlyAmount  Float?
  requiredAmount Float
  signedAt       DateTime?
  signedBy       String?
  totalPaid      Float         @default(0)
  updatedAt      DateTime      @updatedAt
  week1Amount    Float?
  week2Amount    Float?
  week3Amount    Float?
  week4Amount    Float?
  church         Church        @relation(fields: [churchId], references: [id])
  member         Member        @relation(fields: [memberId], references: [id])

  @@unique([churchId, memberId, month, year])
  @@index([churchId])
  @@index([memberId])
}

model WelfareRequest {
  id             String         @id @default(uuid())
  churchId       String
  memberId       String
  type           WelfareType
  description    String
  status         RequestStatus  @default(pending)
  approvedBy     String?
  approvedAmount Float?
  approvedAt     DateTime?
  createdAt      DateTime       @default(now())
  payout         WelfarePayout?
  church         Church         @relation(fields: [churchId], references: [id])
  member         Member         @relation(fields: [memberId], references: [id])

  @@index([churchId])
}

model WelfarePayout {
  id        String         @id @default(uuid())
  churchId  String
  requestId String         @unique
  amount    Float
  paidBy    String
  paidAt    DateTime       @default(now())
  church    Church         @relation(fields: [churchId], references: [id])
  request   WelfareRequest @relation(fields: [requestId], references: [id])

  @@index([churchId])
}

model ContributionType {
  id            String         @id @default(uuid())
  churchId      String
  name          String
  description   String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  contributions Contribution[]
  church        Church         @relation(fields: [churchId], references: [id])

  @@index([churchId])
}

model Contribution {
  id                 String           @id @default(uuid())
  churchId           String
  memberId           String
  contributionTypeId String
  amount             Float
  paymentMethod      PaymentMethod    @default(cash)
  recordedBy         String
  createdAt          DateTime         @default(now())
  church             Church           @relation(fields: [churchId], references: [id])
  contributionType   ContributionType @relation(fields: [contributionTypeId], references: [id])
  member             Member           @relation(fields: [memberId], references: [id])

  @@index([churchId])
  @@index([memberId])
}

model Offering {
  id          String      @id @default(uuid())
  churchId    String
  serviceDate DateTime
  serviceType ServiceType
  cashAmount  Float       @default(0)
  momoAmount  Float       @default(0)
  totalAmount Float
  notes       String?
  recordedBy  String
  createdAt   DateTime    @default(now())
  church      Church      @relation(fields: [churchId], references: [id])

  @@index([churchId])
}

model Expense {
  id          String   @id @default(uuid())
  churchId    String
  title       String
  category    String
  amount      Float
  description String?
  recordedBy  String
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  church      Church   @relation(fields: [churchId], references: [id])

  @@index([churchId])
}

model AuditLog {
  id         String   @id @default(uuid())
  churchId   String
  userId     String
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())
  church     Church   @relation(fields: [churchId], references: [id])

  @@index([churchId])
  @@index([userId])
}

model SmsLog {
  id             String   @id @default(uuid())
  churchId       String
  recipientPhone String
  recipientName  String?
  message        String
  status         String
  provider       String   @default("arkesel")
  sentAt         DateTime @default(now())
  memberId       String?
  type           String
  church         Church   @relation(fields: [churchId], references: [id])
  member         Member?  @relation(fields: [memberId], references: [id])

  @@index([churchId])
}

enum SubscriptionPlan {
  starter
  growth
  pro
}

enum SubscriptionStatus {
  active
  suspended
}

enum UserRole {
  pastor
  treasurer
  secretary
}

enum Gender {
  male
  female
}

enum MemberStatus {
  active
  inactive
  deceased
}

enum PaymentMethod {
  cash
  momo
}

enum PaymentStatus {
  paid
  unpaid
}

enum WelfareType {
  bereavement_parent
  bereavement_child
  childbirth
  marriage
}

enum RequestStatus {
  pending
  approved
  rejected
}

enum ServiceType {
  sunday
  midweek
  special
}
